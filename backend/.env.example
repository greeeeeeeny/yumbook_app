SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: connect Django ORM to Supabase Postgres (pooled connection string).
# Leave unset to use the local SQLite db (db.sqlite3) for dev.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgresql://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres
# DATABASE_SSL=true
