# Supabase Postgres 연결 문자열 (Django ORM 이 사용하는 DB).
# DATABASE_URL 이 Supabase Postgres 접속 문자열이다. 미설정 시 로컬 SQLite(db.sqlite3) 사용.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres
# Postgres 연결에 SSL 강제 여부 (Supabase 권장 true)
DATABASE_SSL=true

# Supabase REST/Storage 엔드포인트
SUPABASE_URL=https://your-project-ref.supabase.co

# 클라이언트/공개용 anon 키
SUPABASE_ANON_KEY=your-supabase-anon-key

# 서버사이드 전용 service_role 키 (Storage 업로드 등 관리 작업용, 절대 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 식당 이미지 Storage 버킷 이름 (기본값 restaurants)
SUPABASE_STORAGE_BUCKET=restaurants
